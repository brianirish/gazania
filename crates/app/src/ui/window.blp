using Gtk 4.0;
using Adw 1;

template $GazaniaWindow : Adw.ApplicationWindow {
  title: "Gazania";
  default-width: 900;
  default-height: 640;
  width-request: 360;
  height-request: 300;

  content: Adw.ToastOverlay toasts {
    Adw.NavigationView navigation {
      $GazaniaOverviewPage overview {}
    }
  };
}
